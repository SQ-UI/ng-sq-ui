{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/ng-sq-common",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "assets": [
    {
      "glob": "*.scss",
      "input": "src/lib/styles",
      "output": "styles"
    },
    {
      "glob": "sq-ui-theme.scss",
      "input": "src/lib",
      "output": "."
    }
  ],
  "allowedNonPeerDependencies": [
    "tslib"
  ]
}
