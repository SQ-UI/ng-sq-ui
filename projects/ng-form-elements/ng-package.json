{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/ng-form-elements",
  "lib": {
    "entryFile": "src/index.ts"
  },
  "assets": [
    {
      "glob": "form-elements.scss",
      "input": "src/lib/styles",
      "output": "styles"
    },
    {
      "glob": "tokens.scss",
      "input": "package-styles",
      "output": "styles"
    }
  ],
  "allowedNonPeerDependencies": [
    "tslib"
  ]
}
