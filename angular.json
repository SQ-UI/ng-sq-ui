{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "sq-ui": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "app",
      "schematics": {},
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/sq-ui",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "src/tsconfig.app.json",
            "assets": [
              "src/assets"
            ],
            "styles": [
              "node_modules/@fortawesome/fontawesome-free/css/fontawesome.min.css",
              "node_modules/@fortawesome/fontawesome-free/css/solid.min.css",
              "node_modules/@fortawesome/fontawesome-free/css/regular.min.css",
              "src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {},
          "configurations": {
            "production": {
              "buildTarget": "sq-ui:build:production"
            },
            "development": {
              "buildTarget": "sq-ui:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "sq-ui:build"
          }
        }
      }
    },
    "ng-sq-ui": {
      "root": "projects/ng-sq-ui",
      "sourceRoot": "projects/ng-sq-ui/src",
      "projectType": "library",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/ng-sq-ui/tsconfig.lib.json",
            "project": "projects/ng-sq-ui/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-sq-ui/tsconfig.lib.prod.json"
            },
            "development": {}
          },
          "defaultConfiguration": "production"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ng-sq-ui/**/*.ts",
              "projects/ng-sq-ui/**/*.html"
            ]
          }
        }
      }
    },
    "ng-datetime-picker": {
      "root": "projects/ng-datetime-picker",
      "sourceRoot": "projects/ng-datetime-picker/src",
      "projectType": "library",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/ng-datetime-picker/tsconfig.lib.json",
            "project": "projects/ng-datetime-picker/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-datetime-picker/tsconfig.lib.prod.json"
            },
            "development": {}
          },
          "defaultConfiguration": "production"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ng-datetime-picker/**/*.ts",
              "projects/ng-datetime-picker/**/*.html"
            ]
          }
        }
      }
    },
    "ng-datatable": {
      "root": "projects/ng-datatable",
      "sourceRoot": "projects/ng-datatable/src",
      "projectType": "library",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/ng-datatable/tsconfig.lib.json",
            "project": "projects/ng-datatable/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-datatable/tsconfig.lib.prod.json"
            },
            "development": {}
          },
          "defaultConfiguration": "production"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ng-datatable/**/*.ts",
              "projects/ng-datatable/**/*.html"
            ]
          }
        }
      }
    },
    "ng-sq-common": {
      "root": "projects/ng-sq-common",
      "sourceRoot": "projects/ng-sq-common/src",
      "projectType": "library",
      "prefix": "lib",
      "architect": {
