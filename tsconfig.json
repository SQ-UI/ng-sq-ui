{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "es2022",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "target": "ES2022",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "lib": [
      "es2022",
      "dom"
    ],
    // The editor's TypeScript server only discovers files named `tsconfig.json`, so spec files are
    // type-checked against this config: it loads the Vitest globals (`describe`, `it`, `vi`, ...).
    // Every derived tsconfig (lib, app, spec) sets its own `types`, so builds are unaffected.
    "types": [
      "vitest/globals",
      "node"
    ],
    // The editor (TypeScript + Angular language service) reads this file, so `@sq-ui/*` maps to the
    // library sources only: a stale or half-built `dist/` can never produce bogus diagnostics.
    // The production app build and `npm run typecheck` check against the built packages via
    // `tsconfig.dist.json`; `ng serve` uses these source paths through `src/tsconfig.app.dev.json`.
    // Each library's `tsconfig.lib.json` keeps its own paths.
    "paths": {
      "@sq-ui/ng-sq-ui": ["./projects/ng-sq-ui/src"],
      "@sq-ui/ng-sq-ui/*": ["./projects/ng-sq-ui/src/*"],
      "@sq-ui/ng-datetime-picker": ["./projects/ng-datetime-picker/src"],
      "@sq-ui/ng-datetime-picker/temporal": ["./projects/ng-datetime-picker/temporal/src"],
      "@sq-ui/ng-datetime-picker/*": ["./projects/ng-datetime-picker/src/*"],
      "@sq-ui/ng-datatable": ["./projects/ng-datatable/src"],
      "@sq-ui/ng-datatable/*": ["./projects/ng-datatable/src/*"],
      "@sq-ui/ng-sq-common": ["./projects/ng-sq-common/src"],
      "@sq-ui/ng-sq-common/*": ["./projects/ng-sq-common/src/*"],
      "@sq-ui/ng-modal": ["./projects/ng-modal/src"],
      "@sq-ui/ng-modal/*": ["./projects/ng-modal/src/*"],
      "@sq-ui/ng-form-elements": ["./projects/ng-form-elements/src"],
      "@sq-ui/ng-form-elements/*": ["./projects/ng-form-elements/src/*"],
      "@sq-ui/ng-progress-bar": ["./projects/ng-progress-bar/src"],
      "@sq-ui/ng-progress-bar/*": ["./projects/ng-progress-bar/src/*"]
    }
  }
}
